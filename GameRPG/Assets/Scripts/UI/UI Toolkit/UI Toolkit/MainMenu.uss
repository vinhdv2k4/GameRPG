.Button {
    position: absolute;
    width: 386px;
    top: 909px;
    left: 710px;
    background-image: none;
    background-color: rgba(255, 255, 255, 0);
    -unity-font-style: bold-and-italic;
    color: rgb(245, 250, 250);
    opacity: 1;
}

.Button:hover {
    opacity: 1;
    font-size: 14px;
    transition-duration: 0.25s;
    scale: 1.2 1.2;
}
